{
    "name": "cdyun/thinkphp-framework",
    "type": "project",
    "keywords": [
        "cdyun",
        "framework",
        "thinkphp",
        "ORM"
    ],
    "homepage": "https://github.com/cdyun303/thinkphp-framework",
    "license": "MIT",
    "description": "基于 thinkphp 开发脚手架，支持模块插件化。",
    "authors": [
        {
            "name": "cdyun",
            "email": "121625706@qq.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "121625706@qq.com",
        "issues": "https://github.com/cdyun303/thinkphp-framework/issues",
        "wiki": "https://doc.thinkphp.cn/v8_0/preface.html",
        "source": "https://github.com/cdyun303/thinkphp-framework"
    },
    "require": {
        "php": ">=8.0.0",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0|^4.0",
        "topthink/think-filesystem": "^2.0|^3.0",
        "topthink/think-multi-app": "^1.1",
        "topthink/think-helper": "^3.1",
        "cdyun/thinkphp-response": "^2.0",
        "cdyun/thinkphp-cache": "^1.0",
        "cdyun/php-tool": "^2.0",
        "cdyun/thinkphp-upload": "^1.0"
    },
    "require-dev": {
        "topthink/think-dumper": "^1.0",
        "topthink/think-trace": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app",
            "support\\": "support"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish",
            "@php think plugin:publish"
        ]
    }
}
